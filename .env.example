# Application Port
PORT=3000
NODE_ENV=development

# Session Configuration
SESSION_SECRET=zenix-secret-session-key

# Database (Optional - Cloud SQL / PostgreSQL)
# When not set, the app runs with an in-memory storage layer
DATABASE_URL=

# Replit OAuth (Optional)
REPL_ID=
ISSUER_URL=https://replit.com/oidc

# AI & Gemini API (Server-side)
GEMINI_API_KEY=
